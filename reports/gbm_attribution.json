  "final_verdict": {
    "primary": "(a) \u98ce\u683c\u8f6e\u52a8\u6210\u7acb \u2014\u2014 \u4e3b\u56e0\uff0c\u4e14\u4e3a\u552f\u4e00\u5728\u603b\u4f53\u4e0a\u6210\u7acb\u7684\u5047\u8bbe",
    "mechanism": "GBM\u2212\u52a8\u91cf\u7684\u6708\u5ea6\u8d85\u989d\u6536\u76ca\u5bf9\u6a2a\u622a\u9762\u52a8\u91cf\u56e0\u5b50\u6536\u76ca\u56de\u5f52: beta=-0.4782 (R\u00b2=0.6076, corr=-0.7795)\uff1b\u5bf9\u51b2\u52a8\u91cf\u66b4\u9732\u540e 2024+ \u6b8b\u5dee -0.0306%/mo \u2248 0\u30022024/2026 \u5e74\u52a8\u91cf\u56e0\u5b50 3.3546/2.7145%/mo\uff0c\u4e3a 2017 \u5e74\u4ee5\u6765\u7b2c 2/3 \u5f3a\u7684\u5e74\u4efd\u3002GBM \u5206\u6b67\u6301\u4ed3\u5bf9\u6781\u7aef\u52a8\u91cf\u80a1\u7ed3\u6784\u6027\u4f4e\u914d\uff08\u5206\u6b67\u80a1\u7b7e\u540d mom_12_1 z: GBM-only -0.2245 vs \u52a8\u91cf-only 1.8273\uff09\uff0c\u8be5\u7b7e\u540d 2024+ \u4e0e 2021-23 \u5b8c\u5168\u4e00\u81f4 \u2014\u2014 \u6a21\u578b\u6ca1\u53d8\uff0c\u5e02\u573a\u98ce\u683c\u53d8\u4e86\u3002\u540c\u4e00\u7ed3\u6784\u5728 2021-22 \u52a8\u91cf\u5d29\u6e83\u671f\uff08\u56e0\u5b50 \u22122.65/\u22123.15%/mo\uff09\u6b63\u662f GBM \u5927\u5e45\u8dd1\u8d85\u7684\u6765\u6e90\u3002\u5206\u6b67\u5f52\u56e0\uff1a2024/2026 \u8dd1\u8f93\u51e0\u4e4e\u5168\u90e8\u6765\u81ea\u52a8\u91cf-only \u817f\uff08+3.2/+4.8%/mo\uff09\u800c\u975e GBM-only \u817f\u53d8\u5dee\uff082024 \u5e74 GBM-only \u817f\u4ecd +1.4%/mo\uff09\u3002",
    "b_model_decay_detail": "\u603b\u4f53\u4e0d\u6210\u7acb\uff1aIC \u5747\u503c 2024+ 0.0114 vs \u4e4b\u524d 0.0058\uff08welch p=0.8768\uff09\uff0ctop10 \u6c60\u5185\u8d85\u989d 1.8676 vs 2.2526%/mo\u3002\u6b21\u7ea7\u8b66\u62a5\uff1a2026 YTD IC=-0.0534\uff08\u6700\u5dee\u5e74\u4efd\uff0c\u4ec5 7 \u4e2a\u6708\uff09\uff0c2026 \u98ce\u683c\u5bf9\u51b2\u540e\u6b8b\u5dee -1.8437%/mo (t\u2248-1.6117\uff0c\u22481\u03c3 \u4e0d\u663e\u8457)\uff1aORCL/NOW/MSFT \u516d\u6708\u66b4\u8dcc+\u53cd\u590d\u9519\u8fc7 INTC/AMD \u66b4\u6da8\u3002\u6837\u672c\u592a\u77ed\uff0c\u4e0d\u8db3\u4ee5\u63a8\u7ffb\u300e\u672a\u9000\u5316\u300f\u7ed3\u8bba\uff0c\u4f46\u5fc5\u987b\u76d1\u63a7\u3002\u7279\u5f81\u91cd\u8981\u5ea6\u5411\u91cf\u786e\u6709\u6f02\u79fb\uff08\u56fa\u5b9a\u7a97\u91cd\u8bad cosine 0.28-0.47\uff09\uff0c\u4f46 IC \u7a33\u5b9a\u8bf4\u660e\u662f\u7279\u5f81\u518d\u52a0\u6743\u800c\u975e\u9884\u6d4b\u529b\u4e22\u5931\u3002",
    "c_crowding_detail": "\u4e0d\u53ef\u5224\u5b9a\uff08\u65e0\u5916\u90e8\u6301\u4ed3/\u8d44\u91d1\u6d41\u6570\u636e\uff09\u3002\u95f4\u63a5\u8bc1\u636e\u4e0d\u652f\u6301\uff1a\u62e5\u6324\u6700\u5148\u4fb5\u8680\u6c60\u5185\u8d85\u989d\uff0c\u800c GBM top10 \u6c60\u5185\u8d85\u989d 2024-25 \u672a\u6536\u655b\uff1b\u4e14\u672c\u673a\u5236\u65e0\u9700\u62e5\u6324\u5047\u8bbe\u5373\u53ef\u5b8c\u5168\u89e3\u91ca\u8dd1\u8f93\u3002",
    "d_noise_detail": "\u4e0d\u6210\u7acb\uff1a\u4ee5 pre-2024 \u6708\u5ea6\u8d85\u989d DGP \u505a block bootstrap\uff0c33 \u4e2a\u6708\u7d2f\u8ba1 \u2264 \u89c2\u6d4b\u503c(-28.9873pp) \u7684\u6982\u7387 \u4ec5 0.0013\u3002\u8dd1\u8f93\u662f\u6761\u4ef6\u6027\u7684\uff08\u56e0\u5b50\u9006\u98ce\uff09\uff0c\u4e0d\u662f\u8fd0\u6c14\u5dee\u3002",
    "recommendation": "\u63a5\u5165\uff0c\u5f62\u6001\u4e3a\u300e\u4e0e\u52a8\u91cf\u5e76\u884c/\u6df7\u5408\u300f\u800c\u975e\u66ff\u4ee3\u3002\u7406\u7531\uff1a(1) \u6c60\u5185\u9009\u80a1\u80fd\u529b\u5065\u5728\uff08IC/\u8d85\u989d 2024-25 \u4e0d\u964d\uff09\uff1b(2) \u8dd1\u8f93\u96c6\u4e2d\u5728\u52a8\u91cf\u56e0\u5b50\u6781\u7aef\u5e74\u4efd\u4e14\u65b9\u5411\u53ef\u89e3\u91ca\u3001\u53ef\u5bf9\u51b2\uff1b(3) \u4e24\u7b56\u7565\u6708\u5ea6\u76f8\u5173\u4ec5 0.5453\uff0c50/50 \u6df7\u5408\u6708\u9891 Sharpe 0.9374 vs \u5355\u540a GBM 0.9334/\u52a8\u91cf 0.7102\u3002\u7ea2\u7ebf\uff08\u89e6\u53d1\u4efb\u4e00\u5219\u964d\u7ea7\u4e3a\u89c2\u5bdf\uff09\uff1a\u2460 \u6eda\u52a8 12 \u4e2a\u6708 IC \u8fde\u7eed 6 \u4e2a\u6708 < 0\uff1b\u2461 \u98ce\u683c\u5bf9\u51b2\u540e 12 \u4e2a\u6708\u6eda\u52a8\u6b8b\u5dee < \u22121%/mo\u3002"
